# ---- Java / Maven ----
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
# 本地依赖缓存（约 0.7GB，由 ~/.m2 复制而来，绝不提交）
.mvn/repo/
.mvn/wrapper/
# 本机专用 Maven 配置（含绝对路径与代理，模板见 .mvn/settings.xml.example）
.mvn/settings.xml

# ---- IDE ----
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# ---- 临时与日志 ----
.tmp/
logs/
*.log
tmp/

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 前端 ----
node_modules/
dist/

# CSS 清理前的本地备份（确认外观无误后可删除）
smart-gateway/src/main/resources/static/.styles.backup-*.css

# ---- 部署包 / 上传分片（体积大，GitHub 单文件限制 100MB，绝不提交）----
*.zip
!deploy/smartmes-static-demo.zip
smartmes-deploy.zip
upload-split/
smartmes-static-demo.zip.bak

# ---- 凭据文件（密码 / JWT / frp token，绝不提交；示例文件保留）----
deploy/.env
deploy/frp/*.toml
deploy/frp/*.ini
!deploy/frp/*.example.toml
!deploy/frp/*.example.ini

# ---- 本地验证脚本 / 临时产物 ----
prototypes/.verify-*
prototypes/.cdp-*
prototypes/.launch-*
prototypes/*.log
prototypes/*.err
prototypes/preview-*.png
